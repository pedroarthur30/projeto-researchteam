# ==========================================
# 1. CHAVES OBRIGATÓRIAS (Core & Segurança)
# ==========================================
OPENAI_API_KEY=sk-proj-...
TAVILY_API_KEY=tvly-...

# Chave interna exigida no header X-API-Key da API FastAPI (falha no boot se ausente)
# Gere uma segura com: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_API_KEY=gere-uma-chave-segura-aqui

# ==========================================
# 2. OBSERVABILIDADE (LangSmith)
# ==========================================
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT=projeto-researchteam

# ==========================================
# 3. MODELOS & FALLBACK (Opcionais)
# ==========================================
OPENAI_AGENT_MODEL=gpt-4o-mini
OPENAI_EXTRACTOR_MODEL=gpt-4o-mini
OPENAI_WRITER_MODEL=gpt-4o

# Se definida, ativa o Claude como backup automático caso a OpenAI falhe na redação final
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BACKUP_MODEL=claude-3-5-haiku-latest

# ==========================================
# 4. RAG & ARMAZENAMENTO (Opcionais)
# ==========================================
# DATA_PATH=./data
# CHROMA_PATH=./chroma_db
RAG_SCORE_THRESHOLD=0.35